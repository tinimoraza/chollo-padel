{
  "manifest_version": 3,
  "name": "Chollo Padel Tiendas",
  "version": "1.0",
  "description": "Scraper de tiendas de pádel (WooCommerce Store API) — bypasa Cloudflare usando Chrome real",
  "permissions": [
    "alarms",
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://padelcoronado.com/*",
    "https://www.padelstyle.com/*",
    "https://padel.tienda/*",
    "https://www.tiendapadelpoint.com/*",
    "https://originalpadel.com/*",
    "https://*.supabase.co/*",

    "https://www.padelnuestro.com/*",
    "https://padelzoom.es/*",
    "https://www.tennis-point.es/*",
    "https://www.padelproshop.com/*",
    "https://www.padeliberico.com/*",
    "https://romasport.es/*",
    "https://padelmarket.com/*",
    "https://www.streetpadel.com/*",
    "https://www.zonadepadel.es/*",
    "https://www.ofertasdepadel.com/*",
    "https://starvie.com/*",
    "https://www.padelvice.com/*",
    "https://www.misterpadel.com/*",
    "https://www.time2padel.com/*",
    "https://www.padelkiwi.com/*",
    "https://www.padel-spain.es/*",
    "https://tiendapadel5.com/*",
    "https://allforpadel.com/*",
    "https://www.m1padel.com/*",
    "https://www.stockpadel.com/*",
    "https://futurapadelshop.com/*",
    "https://justpadel.com/*",
    "https://virtualpadel.es/*",
    "https://outletdepadel.com/*",
    "https://padelmania.com/*",
    "https://keepadel.com/*",
    "https://pelotapadel.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chollo Padel Tiendas",
    "default_icon": "icon.png"
  }
}
